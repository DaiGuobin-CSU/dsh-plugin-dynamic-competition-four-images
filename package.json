{
  "name": "dsh-plugin-dynamic-competition-four-images",
  "version": "1.2.1",
  "description": "动态竞争·四象模型技能插件：插件全局安装，技能在「设置 → 插件」里按工作区选择性添加，只写入你选择的工作区。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "skills",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "workspace-skill",
    "competition"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.5"
  },
  "scripts": {
    "test": "node --test test/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "author": "",
  "license": "MIT"
}
